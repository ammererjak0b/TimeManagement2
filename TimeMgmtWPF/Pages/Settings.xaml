<Page x:Class="TimeMgmtWPF.Pages.Settings"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TimeMgmtWPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Settings">

    <Grid RenderTransformOrigin="0.466,0.512">
        <TextBox x:Name="txtPersonal" Style="{DynamicResource TextBoxStyle}" HorizontalAlignment="Left" Margin="321,90,0,0" VerticalAlignment="Top" Width="200" Height="20" PreviewTextInput="NumberValidationTextBox" MaxLength="4" IsReadOnly="True" Foreground="{DynamicResource PrimaryColor2}"/>
        <TextBox x:Name="txtFlexibleHours" Style="{DynamicResource TextBoxStyle}" HorizontalAlignment="Left" Margin="321,115,0,0" VerticalAlignment="Top" Width="200" Height="20"/>

        <!--Texboxen Check In und Check Out-->
        <TextBox x:Name="txtCheckInHH" Style="{DynamicResource TextBoxStyle}" HorizontalAlignment="Left" Margin="321,140,0,0" VerticalAlignment="Top" Width="38" Height="20" ToolTip="Enter Hours" PreviewTextInput="NumberValidationTextBox" MaxLength="2"/>
        <TextBox x:Name="txtCheckInMM" Style="{DynamicResource TextBoxStyle}" HorizontalAlignment="Left" Margin="366,140,0,0" VerticalAlignment="Top" Width="38" Height="20" ToolTip="Enter Minutes" PreviewTextInput="NumberValidationTextBox" MaxLength="2"/>

        <TextBox x:Name="txtCheckOutHH" Style="{DynamicResource TextBoxStyle}" HorizontalAlignment="Left" Margin="321,165,0,0" VerticalAlignment="Top" Width="38" Height="20" ToolTip="Enter Hours" PreviewTextInput="NumberValidationTextBox" MaxLength="2"/>
        <TextBox x:Name="txtCheckOutMM" Style="{DynamicResource TextBoxStyle}" HorizontalAlignment="Left" Margin="366,165,0,0" VerticalAlignment="Top" Width="38" Height="20" ToolTip="Enter Minutes" PreviewTextInput="NumberValidationTextBox" MaxLength="2"/>
        <Label x:Name="lblPersonal" Style="{DynamicResource LabelStyle}" Content="Personal ID:" HorizontalAlignment="Left" Margin="161,85,0,0" VerticalAlignment="Top"/>
        <Label x:Name="lblFlexibleHours" Style="{DynamicResource LabelStyle}" Content="Flexible Hours:" HorizontalAlignment="Left" Margin="161,110,0,0" VerticalAlignment="Top"/>
        <Label x:Name="lblCheckIn" Style="{DynamicResource LabelStyle}" Content="Standard CheckIn:" HorizontalAlignment="Left" Margin="161,135,0,0" VerticalAlignment="Top"/>
        <Label x:Name="lblCheckOut" Style="{DynamicResource LabelStyle}" Content="Standard CheckOut:" HorizontalAlignment="Left" Margin="161,160,0,0" VerticalAlignment="Top"/>
        <Label x:Name="lblTheme" Style="{DynamicResource LabelStyle}" Content="Theme:" HorizontalAlignment="Left" Margin="161,185,0,0" VerticalAlignment="Top"/>
        <Label x:Name="lblTitle" Style="{DynamicResource LabelStyle}" Content="Settings" HorizontalAlignment="Left" Margin="159,27,0,0" VerticalAlignment="Top" FontSize="35"/>
        <CheckBox x:Name="checkStayLogged" Style="{DynamicResource CheckBoxStyle}" Content="Stay logged in?" HorizontalAlignment="Left" Margin="430,197,0,0" VerticalAlignment="Top" Width="91" Height="14"/>
        <Button x:Name="btnUpdate" Style="{DynamicResource ButtonStyle}" Content="Update" HorizontalAlignment="Left" Margin="468,216,0,0" VerticalAlignment="Top" Click="btnUpdate_Click" Height="26" Width="53"/>

        <ComboBox x:Name="cbTheme" Style="{DynamicResource ComboBoxStyle}" HorizontalAlignment="Left" Margin="321,193,0,0" VerticalAlignment="Top" Width="95">
            <ComboBoxItem>Light Theme</ComboBoxItem>
            <ComboBoxItem>Dark Theme</ComboBoxItem>
        </ComboBox>

        <Label x:Name="lblInfo" Style="{DynamicResource LabelStyleSub}" HorizontalAlignment="Left" Margin="551,344,0,0" VerticalAlignment="Top">
            <Hyperlink NavigateUri="UserSettings.xaml">Go to User settings:</Hyperlink>
        </Label>


    </Grid>
</Page>
