<Page x:Class="TimeMgmtWPF.Pages.Register"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TimeMgmtWPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Register">

    <Grid>
        <TextBox x:Name="txtPersonal" Style="{DynamicResource TextBoxStyle}" HorizontalAlignment="Left" Margin="304,84,0,0" VerticalAlignment="Top" Width="200" Height="20" PreviewTextInput="NumberValidationTextBox" MaxLength="4"/>
        <TextBox x:Name="txtPrename" Style="{DynamicResource TextBoxStyle}" HorizontalAlignment="Left" Margin="304,109,0,0" VerticalAlignment="Top" Width="200" Height="20"/>
        <TextBox x:Name="txtSurname" Style="{DynamicResource TextBoxStyle}" HorizontalAlignment="Left" Margin="304,134,0,0" VerticalAlignment="Top" Width="200" Height="20"/>

        <PasswordBox x:Name="txtPw" Style="{DynamicResource PwTextBoxStyle}" HorizontalAlignment="Left" VerticalAlignment="Top" Width="200" Height="20" Margin="304,184,0,0"/>
        <PasswordBox x:Name="txtPwConfirm" Style="{DynamicResource PwTextBoxStyle}" HorizontalAlignment="Left" VerticalAlignment="Top" Width="200" Height="20" Margin="304,209,0,0"/>
        <TextBox x:Name="txtFlexibleHours" Style="{DynamicResource TextBoxStyle}" HorizontalAlignment="Left" Margin="304,159,0,0" VerticalAlignment="Top" Width="200" Height="20" PreviewTextInput="NumberValidationTextBoxDouble"/>

        <Label x:Name="lblPersonal" Style="{DynamicResource LabelStyle}" Content="Personal ID:" HorizontalAlignment="Left" Margin="161,79,0,0" VerticalAlignment="Top" Width="132"/>
        <Label x:Name="lblPrename" Style="{DynamicResource LabelStyle}" Content="Prename:" HorizontalAlignment="Left" Margin="161,104,0,0" VerticalAlignment="Top" Width="132"/>
        <Label x:Name="lblSurname" Style="{DynamicResource LabelStyle}" Content="Surname:" HorizontalAlignment="Left" Margin="161,129,0,0" VerticalAlignment="Top" Width="132"/>

        <Label x:Name="lblPassword" Style="{DynamicResource LabelStyle}" Content="Password:" HorizontalAlignment="Left" Margin="161,179,0,0" VerticalAlignment="Top" Width="132"/>
        <Label x:Name="lblPasswordConfirm" Style="{DynamicResource LabelStyle}" Content="Password Confirm:" HorizontalAlignment="Left" Margin="161,204,0,0" VerticalAlignment="Top"/>
        <Label x:Name="lblFlexibleHours" Style="{DynamicResource LabelStyle}" Content="Flexible Hours:" HorizontalAlignment="Left" Margin="161,154,0,0" VerticalAlignment="Top" Width="132"/>

        <Label x:Name="lblTitle" Style="{DynamicResource LabelStyle}" Content="Register" HorizontalAlignment="Left" Margin="159,21,0,0" VerticalAlignment="Top" FontSize="35"/>
        <Label x:Name="lblInfo" Style="{DynamicResource LabelStyleSub}" HorizontalAlignment="Left" Margin="535,344,0,0" VerticalAlignment="Top" Width="175">
            <Hyperlink NavigateUri="Login.Xaml">Already have an Account? Login here:</Hyperlink>
        </Label>

        <Button x:Name="btnSubmit" Style="{DynamicResource IconButtonsStyle}" Content="{DynamicResource login}" HorizontalAlignment="Left" Margin="480,229,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.597,-0.213" Click="btnSubmit_Click"/>

    </Grid>
</Page>
